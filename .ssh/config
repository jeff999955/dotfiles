# SSH configuration for remote-ubc
Host jumphost
    HostName jumphost.cs.ubc.ca
    User jeffyct

# SSH configuration for neptune
Host neptune
    HostName neptune.cs.ubc.ca
    User jeffyct

Host koi
    HostName koi.cs.ubc.ca
    User jeffyct

Host goldie
    HostName goldie.cs.ubc.ca
    User jeffyct
    ProxyJump remote.cs.ubc.ca

# SSH configuration for snubfin
Host snubfin
    HostName submit-cs.cs.ubc.ca
    User jeffyct

# SSH configuration for submit-ml
Host submit-ml
    HostName submit-ml.cs.ubc.ca
    User jeffyct

# SSH configuration for sockeye
Host sockeye
    HostName sockeye.arc.ubc.ca
    User jeffyct
    ServerAliveInterval 60
    ServerAliveCountMax 100
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 24h

# SSH configuration for narval
Host narval
    HostName narval.alliancecan.ca
    User jeffyct

Host fir
    HostName fir.alliancecan.ca
    User jeffyct

Host shimano
    HostName 198.162.54.46
    User nl
    # Do not request a terminal (pty)...
    RequestTTY no
    # ...and do not let the shell try to launch a remote command.
    RemoteCommand none

Host ubc8
    HostName ubc8.1000jeff.uk
    User jeffyct
    ProxyCommand cloudflared access ssh --hostname %h

# Lab machines — all NFS-mount /ubc/cs/research/kmyi/jeffyct
